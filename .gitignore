# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/

# Session prompt residue (not part of the deliverable)
.prompt-phase0-prep.txt
.prompt-strengthen.txt
.prompt-gpu-ready.txt

# HuggingFace model cache (weights are large + regenerable; never commit)
.hf_cache/

# On-disk activation cache produced by the real CPU provider (regenerable)
.act_cache/

# Large / regenerable run artifacts. We DO commit the small results JSON +
# human summary (see !exceptions below); everything else under results/ is local.
results/**/activations/
results/**/*.npy
results/**/*.npz

.prompt-*.txt
.worktrees/
copilot-session-*.md
*.bundle

results/arm_full/**/transcripts/
results/arm_full/**/checkpoints/
results/arm_full/**/c1/
results/*.tgz

# E-0011 multi-seed: exclude large subdirs/files, keep small JSON products only
results/E-0011/**/transcripts/
results/E-0011/**/checkpoints/
results/E-0011/**/c1/
results/E-0011/**/activations/

# LaTeX paper build artifacts
docs/paper/build/
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.log
docs/paper/*.out
docs/paper/*.pdf
